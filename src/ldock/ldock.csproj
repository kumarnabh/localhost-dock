<Project Sdk="Microsoft.NET.Sdk">

  <!-- ldock: read-only command line for scripts and AI coding agents. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ldock</AssemblyName>
    <RootNamespace>LocalhostDock.CliHost</RootNamespace>
    <Version>0.4.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalhostDock.Core\LocalhostDock.Core.csproj" />
  </ItemGroup>

</Project>
