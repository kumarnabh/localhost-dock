<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalhostDock</AssemblyName>
    <RootNamespace>LocalhostDock</RootNamespace>
    <Version>0.4.0</Version>
    <Product>Localhost Dock</Product>
    <Description>A tray widget for every local app and dev server you run.</Description>
    <!-- SystemAware: layout is scaled once by Theme.S(); Windows scales the whole window on monitors with a different DPI. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalhostDock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalhostDock.Core\LocalhostDock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\apps.example.json" Link="apps.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\presets\*.json" Link="presets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\integrations\aura\localhost-dock.mjs" Link="integrations\aura\localhost-dock.mjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\AURA.md" Link="docs\AURA.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
